---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ButtonCta from './ButtonCta.astro';
import Icon from './Icon.astro';
import logo from '../assets/icons/logo.svg?url';
import { site } from '../data/site';

interface Props {
  media?: { src: ImageMetadata; alt: string };
}

const { media } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner">
    <span class="hero__logo">
      <Icon src={logo} size={26} />
    </span>

    <h1 id="hero-title" class="hero__headline">
      <span class="hero__line">
        <span class="text-display uppercase">Telling</span>
        <span class="text-display-accent">stories</span>
      </span>
      <span class="hero__line text-display uppercase">through design</span>
    </h1>

    {
      media && (
        <div class="hero__media">
          <Image
            class="hero__thumb"
            src={media.src}
            alt={media.alt}
            widths={[400, 800]}
            sizes="(min-width: 768px) 40rem, calc(100vw - 4rem)"
            loading="eager"
          />
          <ButtonCta label="See my work" href="#projects" icon="down" />
        </div>
      )
    }

    <div class="hero__bio text-body">
      <p>Hi, I’m Andrea :)</p>
      <p class="text-body-emphasis">{site.role}</p>
      <p>I help people with thoughtful design choices.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 51.1875rem;
    padding: 5rem 2rem 7rem;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3.5rem;
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }

  .hero__logo {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
  }

  .hero__headline {
    display: flex;
    flex-direction: column;
    align-items: center;
    white-space: nowrap;
  }

  .hero__line {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.75rem;
  }

  .hero__media {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    width: 100%;
  }

  .hero__thumb {
    width: 100%;
    aspect-ratio: 308 / 172;
    object-fit: cover;
    border: 0.5px solid var(--color-stroke-default);
  }

  .hero__bio {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    white-space: nowrap;
  }

  @media (min-width: 1024px) {
    .hero {
      min-height: 0;
      padding: 9rem var(--page-gutter) 0;
    }

    .hero__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      max-width: calc(80rem - 2 * var(--page-gutter));
      text-align: left;
    }

    .hero__logo,
    .hero__media {
      display: none;
    }

    .hero__bio {
      order: -1;
    }

    .hero__headline {
      width: 34.5rem;
    }
  }
</style>
