---
import { withBase } from '../lib/url';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ButtonCta from './ButtonCta.astro';
import Icon from './Icon.astro';
import ProjectMeta from './ProjectMeta.astro';
import arrowLeft from '../assets/icons/arrow-left.svg?url';
import arrowRight from '../assets/icons/arrow-right.svg?url';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const slides = projects.map((project, index) => ({
  id: project.id,
  href: withBase(`/projects/${project.id}/`),
  number: String(index + 1).padStart(2, '0'),
  image: project.data.thumbnail ?? project.data.cover,
  alt: project.data.coverAlt,
  ...project.data,
}));
const hasMany = slides.length > 1;
---

{
  slides.length > 0 && (
    <section class="featured" id="projects" aria-labelledby="featured-title" data-carousel>
      <header class="featured__header">
        <p class="text-body">
          A collection of recent work showcasing my work in : brand identity design and ui/ux
          projects.
        </p>
        <h2 id="featured-title" class="featured__title">
          <span class="text-display uppercase">Projects</span>
          <span class="text-display-accent">gallery</span>
        </h2>
      </header>

      <div class="featured__carousel">
        <div class="featured__stage">
          {slides.map((slide, index) => (
            <a
              class="featured__image"
              href={slide.href}
              data-slide={index}
              hidden={index !== 0}
              tabindex="-1"
              aria-hidden="true"
            >
              <Image
                src={slide.image}
                alt=""
                widths={[480, 800, 1400]}
                sizes="(min-width: 1024px) 43.3rem, calc(100vw - 4rem)"
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            </a>
          ))}

          {hasMany && (
            <button class="featured__preview" type="button" data-carousel-next>
              <span class="visually-hidden" data-carousel-next-label>
                Next project: {slides[1].title}
              </span>
              {slides.map((slide, index) => (
                <Image
                  src={slide.image}
                  alt=""
                  widths={[400, 700]}
                  sizes="21.7rem"
                  data-preview={index}
                  hidden={index !== 1}
                />
              ))}
            </button>
          )}
        </div>

        {hasMany && (
          <div class="featured__nav">
            <button class="featured__nav-btn text-button uppercase" type="button" data-carousel-prev>
              <Icon src={arrowLeft} size={16} />
              <span>Back</span>
            </button>
            <div class="featured__thumbs">
              {slides.map((slide, index) => (
                <button
                  class="featured__thumb"
                  type="button"
                  data-carousel-goto={index}
                  aria-label={`Show ${slide.title}`}
                  aria-current={index === 0 ? 'true' : undefined}
                >
                  <Image src={slide.image} alt="" widths={[80]} sizes="2.125rem" />
                </button>
              ))}
            </div>
            <button
              class="featured__nav-btn featured__nav-btn--next text-button uppercase"
              type="button"
              data-carousel-next
            >
              <span>Next</span>
              <Icon src={arrowRight} size={16} />
            </button>
          </div>
        )}

        <div class="featured__details" aria-live="polite">
          {slides.map((slide, index) => (
            <article class="featured__slide" data-slide={index} hidden={index !== 0}>
              <div class="featured__title-group">
                <p class="featured__number text-button">{slide.number}</p>
                <h3 class="text-h1 uppercase">{slide.title}</h3>
                <p class="text-body-small">{slide.excerpt ?? slide.summary}</p>
              </div>
              <ProjectMeta class="featured__meta" categories={slide.categories} role={slide.role} />
              <ButtonCta class="featured__view" label="View project" href={slide.href} />
            </article>
          ))}
          <a class="featured__all text-button uppercase" href={withBase('/projects/')}>
            See all projects
          </a>
        </div>
      </div>
    </section>
  )
}

<style>
  .featured {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 4rem;
    min-height: 51.1875rem;
    padding: 2rem;
  }

  .featured__header,
  .featured__carousel {
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
  }

  .featured__header p {
    max-width: 19.5625rem;
  }

  .featured__title {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-size: inherit;
  }

  .featured__carousel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .featured__stage {
    position: relative;
  }

  .featured__image {
    display: block;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-stroke-default);
  }

  .featured__image img,
  .featured__preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured__image[hidden],
  .featured__preview img[hidden],
  .featured__slide[hidden] {
    display: none;
  }

  .featured__preview {
    display: none;
  }

  .featured__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .featured__nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem 0.5rem 0.75rem;
    color: var(--color-button-background);
  }

  .featured__nav-btn--next {
    padding: 0.5rem 0.75rem 0.5rem 1rem;
  }

  .featured__thumbs {
    display: flex;
    gap: 0.75rem;
  }

  .featured__thumb {
    width: 2.125rem;
    height: 1.5rem;
    opacity: 0.1;
    transition: opacity 200ms ease;
  }

  .featured__thumb:hover,
  .featured__thumb[aria-current='true'] {
    opacity: 1;
  }

  .featured__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured__details {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .featured__slide {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .featured__title-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .featured__number {
    color: color-mix(in srgb, var(--color-text-primary) 50%, transparent);
  }

  .featured :global(.featured__meta) {
    width: 100%;
  }

  .featured__all {
    align-self: flex-end;
    color: var(--color-button-background);
  }

  .featured__all:hover,
  .featured__nav-btn:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (min-width: 1024px) {
    .featured {
      display: block;
      min-height: 0;
      padding: 4.5rem 0 0;
    }

    .featured__header {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .featured__carousel {
      display: block;
      max-width: none;
    }

    .featured__stage {
      width: min(43.3125rem, 54vw);
      margin-inline: auto;
    }

    .featured__image {
      border-width: 0.25px;
    }

    .featured__preview {
      position: absolute;
      top: 50%;
      left: calc(100% + 7.25rem);
      display: block;
      width: 50%;
      aspect-ratio: 16 / 9;
      border: 0.125px solid var(--color-stroke-default);
      opacity: 0.3;
      transform: translateY(-50%);
      transition: opacity 200ms ease;
    }

    .featured__preview:hover {
      opacity: 0.6;
    }

    .featured__nav {
      display: none;
    }

    .featured__details {
      display: grid;
      grid-template-columns: 1fr 12.8125rem auto;
      column-gap: 3rem;
      align-items: start;
      max-width: 50rem;
      margin: 8.125rem auto 0;
      padding-bottom: 4rem;
    }

    .featured__slide {
      display: contents;
    }

    .featured__slide[hidden] {
      display: none;
    }

    .featured__title-group {
      gap: 1.5rem;
    }

    .featured__number {
      display: none;
    }

    .featured :global(.featured__meta) {
      flex-direction: column;
    }

    .featured :global(.featured__view) {
      grid-column: 3;
      grid-row: 1;
      justify-self: end;
    }

    .featured__all {
      grid-column: 3;
      grid-row: 1;
      align-self: start;
      justify-self: end;
      margin-top: 4.5625rem;
    }
  }
</style>

<script>
  import { wrapIndex } from '../lib/carousel';

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const slides = root.querySelectorAll<HTMLElement>('.featured__slide');
    const images = root.querySelectorAll<HTMLElement>('.featured__image');
    const previews = root.querySelectorAll<HTMLElement>('[data-preview]');
    const thumbs = root.querySelectorAll<HTMLElement>('[data-carousel-goto]');
    const nextLabel = root.querySelector<HTMLElement>('[data-carousel-next-label]');
    const titles = Array.from(slides, (slide) => slide.querySelector('h3')?.textContent ?? '');
    const count = slides.length;
    let current = 0;

    const show = (index: number) => {
      current = wrapIndex(index, count);
      const next = wrapIndex(current + 1, count);
      slides.forEach((el, i) => (el.hidden = i !== current));
      images.forEach((el, i) => (el.hidden = i !== current));
      previews.forEach((el, i) => (el.hidden = i !== next));
      thumbs.forEach((el, i) => {
        if (i === current) el.setAttribute('aria-current', 'true');
        else el.removeAttribute('aria-current');
      });
      if (nextLabel) nextLabel.textContent = `Next project: ${titles[next]}`;
    };

    root.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest<HTMLElement>(
        '[data-carousel-next], [data-carousel-prev], [data-carousel-goto]',
      );
      if (!target) return;
      if (target.hasAttribute('data-carousel-next')) show(current + 1);
      else if (target.hasAttribute('data-carousel-prev')) show(current - 1);
      else show(Number(target.dataset.carouselGoto));
    });
  });
</script>
