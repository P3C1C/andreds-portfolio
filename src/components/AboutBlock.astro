---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div class:list={['about-block', className]}>
  <h3 class="about-block__title text-h3 uppercase">{title}</h3>
  <slot />
</div>

<style>
  .about-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 1024px) {
    .about-block {
      display: grid;
      grid-template-columns: 5.375rem minmax(0, 1fr);
      align-items: start;
      gap: 4.875rem;
    }
  }
</style>
