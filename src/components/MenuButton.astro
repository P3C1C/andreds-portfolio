---
import Icon from './Icon.astro';
import hamburger from '../assets/icons/hamburger.svg?url';
---

<button
  type="button"
  class="menu-button"
  data-menu-button
  aria-expanded="false"
  aria-controls="site-menu"
  aria-label="Open menu"
>
  <Icon src={hamburger} />
</button>

<style>
  .menu-button {
    display: inline-flex;
    color: var(--color-text-primary);
  }
</style>
