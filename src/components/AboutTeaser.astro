---
import { Image } from 'astro:assets';
import ButtonCta from './ButtonCta.astro';
import Icon from './Icon.astro';
import portrait from '../assets/about/portrait.jpg';
import newspaper from '../assets/textures/about-newspaper.webp';
import club from '../assets/icons/club.svg?url';
import diamond from '../assets/icons/diamond.svg?url';
import heart from '../assets/icons/heart.svg?url';
import spade from '../assets/icons/spade.svg?url';
import { aboutHighlights, type SuitIcon } from '../data/about';

const suitIcons: Record<SuitIcon, string> = { club, diamond, heart, spade };
---

<section class="about-teaser" aria-labelledby="about-teaser-title">
  <div class="about-teaser__bg" aria-hidden="true">
    <Image src={newspaper} alt="" widths={[800, 1400]} sizes="100vw" />
  </div>

  <h2 id="about-teaser-title" class="about-teaser__title">
    A <span class="about-teaser__pixel">bit</span> about me
  </h2>

  <div class="about-teaser__content">
    <Image
      class="about-teaser__photo"
      src={portrait}
      alt="Andrea standing in a city square in front of red brick buildings"
      widths={[400, 750]}
      sizes="(min-width: 1024px) 22.75rem, calc(100vw - 4rem)"
    />

    <ul class="about-teaser__list" role="list">
      {
        aboutHighlights.map((item) => (
          <li class="about-teaser__item">
            <Icon src={suitIcons[item.icon]} size={20} />
            <div class="about-teaser__text">
              <h3 class="text-label uppercase">{item.title}</h3>
              <p class="text-body-small">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <ButtonCta label="More about me" href="/about/" />
</section>

<style>
  .about-teaser {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding: 2rem 2rem 3rem;
    overflow: hidden;
  }

  .about-teaser__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .about-teaser__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.08;
  }

  .about-teaser__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        transparent 0%,
        color-mix(in srgb, var(--color-background-primary) 50%, transparent) 72.115%,
        var(--color-background-primary) 98.464%
      ),
      linear-gradient(
        to bottom,
        transparent 0%,
        color-mix(in srgb, var(--color-background-primary) 50%, transparent) 72.115%,
        var(--color-background-primary) 98.464%
      );
  }

  .about-teaser__title {
    position: relative;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-body);
    text-transform: uppercase;
  }

  .about-teaser__pixel {
    font-family: var(--font-pixel);
    font-size: 1.2em;
    text-transform: none;
  }

  .about-teaser__content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    max-width: 40rem;
  }

  .about-teaser__photo {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .about-teaser__list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
  }

  .about-teaser__item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 0.75rem 0 0.5rem 0.5rem;
    border-top: 1px solid var(--color-stroke-default);
  }

  .about-teaser__item :global(.icon) {
    width: 1rem;
    height: 1rem;
  }

  .about-teaser__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
  }

  .about-teaser :global(.btn-cta) {
    position: relative;
  }

  @media (min-width: 1024px) {
    .about-teaser {
      justify-content: space-between;
      gap: 0;
      min-height: 67.5rem;
      padding: 7.125rem var(--page-gutter) 8.0625rem;
    }

    .about-teaser__title {
      font-weight: var(--font-weight-semibold);
    }

    .about-teaser__pixel {
      font-size: 1.5em;
    }

    .about-teaser__content {
      flex-direction: row;
      gap: 6rem;
      max-width: 51.875rem;
    }

    .about-teaser__photo {
      width: 22.75rem;
      height: auto;
      aspect-ratio: auto;
      align-self: stretch;
    }

    .about-teaser__list {
      justify-content: space-between;
      width: 23.125rem;
      min-height: 36rem;
    }

    .about-teaser__item {
      gap: 2.5rem;
    }

    .about-teaser__item :global(.icon) {
      width: 1.25rem;
      height: 1.25rem;
    }

    .about-teaser__text {
      gap: 1.5rem;
    }
  }
</style>
