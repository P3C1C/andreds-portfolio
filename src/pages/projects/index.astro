---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { sortProjects } from '../../lib/projects';

const projects = sortProjects(await getCollection('projects'));
const intro = 'A curated selection of my recent brand identity and UI/UX projects.';
---

<BaseLayout title="Projects" description={intro}>
  <section class="projects-page" aria-labelledby="projects-title">
    <header class="projects-page__header">
      <h1 id="projects-title" class="projects-page__title">
        <span class="text-display uppercase">Projects</span>{' '}
        <span class="text-display-accent">gallery</span>
      </h1>
      <p class="projects-page__intro text-body">{intro}</p>
    </header>

    <ul class="projects-page__list" role="list">
      {projects.map((project) => <ProjectCard project={project} />)}
    </ul>
  </section>
</BaseLayout>

<style>
  .projects-page {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 5rem var(--page-gutter) 3rem;
  }

  .projects-page__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 1024px) {
    .projects-page {
      gap: 7.5rem;
      padding: calc(var(--header-height) + 7.5rem) 0 7.5rem;
    }

    .projects-page__header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      height: 3.75rem;
      padding-inline: var(--page-gutter);
    }

    .projects-page__intro {
      order: -1;
      max-width: 19.5625rem;
    }
  }
</style>
