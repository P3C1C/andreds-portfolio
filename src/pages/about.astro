---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutBlock from '../components/AboutBlock.astro';
import AboutCard from '../components/AboutCard.astro';
import Icon from '../components/Icon.astro';
import travelPhoto from '../assets/about/travel.webp';
import basketball from '../assets/icons/basketball.svg?url';
import hiking from '../assets/icons/hiking.svg?url';
import frisbee from '../assets/icons/frisbee.svg?url';
import strategy from '../assets/icons/strategy.svg?url';
import rpg from '../assets/icons/rpg.svg?url';
import controller from '../assets/icons/controller.svg?url';
import { outsideWork, whyMe, type InterestIcon } from '../data/about';

const interestIcons: Record<InterestIcon, string> = {
  basketball,
  hiking,
  frisbee,
  strategy,
  rpg,
  controller,
};
const interestGroups = [
  { title: 'Sport', items: outsideWork.sports },
  { title: 'Gamer', items: outsideWork.games },
];
const { travel } = outsideWork;
---

<BaseLayout title="About me" description={whyMe.intro}>
  <div class="about">
    <h1 class="visually-hidden">About me</h1>

    <section class="about__section" aria-labelledby="why-me-title">
      <header class="about__header">
        <h2 id="why-me-title" class="text-display uppercase">Why me?</h2>
        <p class="about__intro text-body">{whyMe.intro}</p>
      </header>

      <AboutBlock title="Impact">
        <ul class="about__grid about__stats" role="list">
          {
            whyMe.stats.map((stat) => (
              <AboutCard>
                <p class="about__stat-value text-h2">{stat.value}</p>
                <div class="about__stat-details">
                  <p class="text-label uppercase">{stat.label}</p>
                  <p class="text-body">{stat.detail}</p>
                </div>
              </AboutCard>
            ))
          }
        </ul>
      </AboutBlock>

      <AboutBlock title="Values">
        <ul class="about__grid about__values" role="list">
          {
            whyMe.values.map((value) => (
              <AboutCard variant={value.variant}>
                <h4 class="text-h3 uppercase">{value.title}</h4>
                <p class="text-body">{value.text}</p>
              </AboutCard>
            ))
          }
        </ul>
      </AboutBlock>
    </section>

    <section class="about__section" aria-labelledby="outside-title">
      <header class="about__header">
        <h2 id="outside-title" class="text-display uppercase">Outside of work</h2>
        <p class="about__intro text-body">{outsideWork.intro}</p>
      </header>

      <AboutBlock title="Travel">
        <ul class="about__grid about__travel" role="list">
          <AboutCard class="about-travel-stat">
            <p class="text-display">{travel.stat.value}</p>
            <p class="text-body uppercase">{travel.stat.label}</p>
          </AboutCard>
          <li class="about__photo">
            <Image
              src={travelPhoto}
              alt={travel.photoAlt}
              widths={[400, 830]}
              sizes="(min-width: 1024px) 25.875rem, calc(100vw - 4rem)"
            />
          </li>
          <AboutCard variant="outlined">
            <h4 class="text-h3 uppercase">{travel.countries.title}</h4>
            <p class="text-body">{travel.countries.text}</p>
          </AboutCard>
          <AboutCard variant="filled">
            <p class="text-body">{travel.reflection}</p>
          </AboutCard>
        </ul>
      </AboutBlock>

      {
        interestGroups.map((group) => (
          <AboutBlock title={group.title}>
            <ul class="about__grid about__interests" role="list">
              {group.items.map((item) => (
                <AboutCard variant={item.variant} class="about-interest">
                  <Icon class="about__interest-icon" src={interestIcons[item.icon]} size={48} />
                  <div class="about__interest-details">
                    <h4 class="text-label uppercase">{item.title}</h4>
                    <p class="text-body">{item.detail}</p>
                  </div>
                </AboutCard>
              ))}
            </ul>
          </AboutBlock>
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  .about {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6rem;
    padding: 5rem var(--page-gutter) 4rem;
  }

  .about__section {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .about__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about__grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about__stats {
    gap: 0;
  }

  .about__stats :global(.about-card) {
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
  }

  .about__stat-value {
    flex-shrink: 0;
    min-width: 3.625rem;
  }

  .about__stat-details {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .about :global(.about-travel-stat),
  .about :global(.about-interest) {
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .about__photo {
    height: 10.9375rem;
  }

  .about__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__interests {
    gap: 0.5rem;
  }

  .about :global(.about-interest) {
    padding: 1rem;
  }

  .about__interest-details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  @media (min-width: 768px) {
    .about__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about__stats,
    .about__interests {
      gap: 1.5rem;
    }

    .about__interests {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .about__photo {
      height: auto;
      min-height: 10.9375rem;
    }
  }

  @media (min-width: 1024px) {
    .about {
      gap: 8.4375rem;
      padding: calc(var(--header-height) + 7.5rem) var(--page-gutter) 7.5rem;
    }

    .about__section {
      gap: 7.5rem;
    }

    .about__header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      height: 3.75rem;
    }

    .about__intro {
      max-width: 19.5625rem;
    }

    .about__grid {
      gap: 3rem;
    }

    .about__stats :global(.about-card) {
      flex-direction: column;
      justify-content: center;
      gap: 1.5rem;
      padding: 2rem;
      text-align: center;
    }

    .about__stat-value {
      font-size: var(--font-size-3xl);
    }

    .about__stat-details {
      align-items: center;
      gap: 0.5rem;
    }

    .about__travel {
      grid-template-rows: repeat(2, 15.875rem);
    }

    .about__photo {
      min-height: 0;
    }

    .about__interests {
      grid-template-rows: 15.875rem;
    }

    .about :global(.about-interest) {
      justify-content: center;
      padding: 2rem;
    }

    .about :global(.about__interest-icon) {
      width: 4rem;
      height: 4rem;
    }
  }
</style>
