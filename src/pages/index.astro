---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GridBackground from '../components/GridBackground.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import Testimonials from '../components/Testimonials.astro';
import AboutTeaser from '../components/AboutTeaser.astro';
import { getFeatured } from '../lib/projects';

const featured = getFeatured(await getCollection('projects'));
const lead = featured[0]?.data;
const heroMedia = lead ? { src: lead.thumbnail ?? lead.cover, alt: lead.coverAlt } : undefined;
---

<BaseLayout>
  <div class="landing-top">
    <GridBackground />
    <HeroSection media={heroMedia} />
    <FeaturedCarousel projects={featured} />
  </div>
  <Testimonials />
  <AboutTeaser />
</BaseLayout>

<style>
  .landing-top {
    position: relative;
    overflow-x: clip;
  }

  @media (min-width: 1024px) {
    .landing-top {
      min-height: 67.5rem;
    }
  }
</style>
