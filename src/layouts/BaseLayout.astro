---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GrainOverlay from '../components/GrainOverlay.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import { site } from '../data/site';
import { DEFAULT_THEME, THEME_STORAGE_KEY } from '../lib/theme';
import { MUTE_STORAGE_KEY } from '../lib/sound';
import { LOADER_FALLBACK_MS, LOADER_STORAGE_KEY } from '../lib/loader';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
---

<!doctype html>
<html lang="en" data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
    <script
      is:inline
      define:vars={{
        themeKey: THEME_STORAGE_KEY,
        muteKey: MUTE_STORAGE_KEY,
        loaderKey: LOADER_STORAGE_KEY,
        loaderFallbackMs: LOADER_FALLBACK_MS,
      }}
    >
      try {
        var storedTheme = localStorage.getItem(themeKey);
        if (storedTheme === 'light' || storedTheme === 'dark') {
          document.documentElement.dataset.theme = storedTheme;
        }
        if (localStorage.getItem(muteKey) === 'true') {
          document.documentElement.dataset.muted = 'true';
        }
        var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (sessionStorage.getItem(loaderKey) !== 'true' && !reducedMotion) {
          document.documentElement.dataset.loading = 'true';
          setTimeout(function () {
            delete document.documentElement.dataset.loading;
            document.querySelectorAll('[data-loader-lock]').forEach(function (element) {
              element.removeAttribute('inert');
            });
            var loaderEl = document.querySelector('[data-loader]');
            if (loaderEl) loaderEl.setAttribute('aria-hidden', 'true');
          }, loaderFallbackMs);
        }
      } catch (error) {}
    </script>
  </head>
  <body>
    <a class="skip-link text-button uppercase" href="#main" data-loader-lock>Skip to content</a>
    <LoadingScreen />
    <GrainOverlay />
    <Header />
    <main id="main" class="site-main" data-loader-lock data-menu-inert>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      if (document.documentElement.dataset.loading) {
        document.querySelectorAll('[data-loader-lock]').forEach(function (element) {
          element.setAttribute('inert', '');
        });
        var loader = document.querySelector('[data-loader]');
        if (loader) loader.removeAttribute('aria-hidden');
      }
    </script>
    <script>
      import '../scripts/preferences';
    </script>
  </body>
</html>

<style>
  .site-main {
    position: relative;
    z-index: 1;
  }
</style>
